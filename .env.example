NODE_ENV=development
PORT=3000

# PostgreSQL 16 (docker compose)
DATABASE_URL=postgresql://secondevie:secondevie@localhost:5432/secondevie?schema=public

# Redis 7 (docker compose)
REDIS_URL=redis://localhost:6379

# Auth — remplacer en production (32 caractères minimum)
JWT_SECRET=change-me-in-production-32-characters-minimum
JWT_ISSUER=secondevie
JWT_AUDIENCE=secondevie-api
JWT_KID=dev-1

# Poivres HMAC des codes, jetons de refresh et de réinitialisation.
# Générer avec : openssl rand -base64 48
AUTH_CODE_PEPPER=change-me-code-pepper-32-characters-minimum
AUTH_REFRESH_PEPPER=change-me-refresh-pepper-32-characters-minimum
AUTH_RESET_PEPPER=change-me-reset-pepper-32-characters-minimum

# Export RGPD : signature des URLs et répertoire de stockage local
EXPORT_SIGNING_SECRET=change-me-export-secret-32-characters-minimum
EXPORT_DIR=.exports

# Stockage objet des photos M2 (MinIO local, S3 en production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=secondevie
S3_SECRET_ACCESS_KEY=secondevie-secret
S3_BUCKET=secondevie
S3_PUBLIC_BASE_URL=http://localhost:9000/secondevie
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_SECONDS=900

# CORS : origines séparées par des virgules
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

LOG_LEVEL=info
